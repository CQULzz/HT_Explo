+def stop_process(proc):
+    if proc.poll() is None:
+        proc.send_signal(signal.SIGINT)
+        try:
+            proc.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            proc.kill(); proc.wait()
+
+
+def finish_encoder(enc):
+    if not enc.stdin.closed:
+        try:
+            enc.stdin.close()
+        except BrokenPipeError:
+            pass
+    try:
+        enc.wait(timeout=15)
+    except subprocess.TimeoutExpired:
+        enc.kill(); enc.wait()
+
