+@pytest.mark.parametrize("drift_enabled", [False, True], ids=["no_drift", "drift"])
+def test_four_fresh_instances_match_every_state_layer_exactly(make_map, drift_enabled):
+    cloud, _ = ground_step_wall()
+    stress = np.vstack([np.tile([.437, .037, -.15], (64, 1)),
+                        np.tile([1.437, .037, -.75], (512, 1)),
+                        np.tile([1.437, .037, -.45], (128, 1)),
+                        np.tile([.637, -.163, -.731], (512, 1)),
+                        np.tile([.637, -.163, -.60], (512, 1))]).astype(np.float32)
+    reference = None
+    for repetition in range(4):
+        mapping = make_map(enable_visibility_cleanup=True, cleanup_cos_thresh=.3,
+                           enable_drift_compensation=drift_enabled,
+                           min_height_drift_cnt=2,
+                           position_noise_thresh=.01,
+                           orientation_noise_thresh=.01,
+                           drift_compensation_alpha=.5)
+        snapshots = []
+        for index, points in enumerate([cloud, stress, cloud, stress]):
+            if index:
+                mapping.param.time_interval = .8
+                mapping.update_time()
+                mapping.update_variance()
+            integrate(mapping, points, stamp=100.125 + index, sensor_height=.75,
+                      position_noise=.05, orientation_noise=.02)
+            snapshots.append(state(mapping))
+        assert int((mapping.elevation_map[2] > .5).sum()) > 100
+        if reference is None:
+            reference = snapshots
+        else:
+            for actual, expected in zip(snapshots, reference, strict=True):
+                assert_same_bits(actual, expected)
