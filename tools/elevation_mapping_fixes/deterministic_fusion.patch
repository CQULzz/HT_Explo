+def test_flat_ground_true_step_and_wall_remain_measured(make_map):
+    mapping = make_map(enable_visibility_cleanup=True)
+    cloud, world = ground_step_wall()
+    for number in range(3):
+        if number:
+            mapping.param.time_interval = .8
+            mapping.update_time()
+            mapping.update_variance()
+        integrate(mapping, cloud, stamp=100.125 + number, sensor_height=.75)
+    measured = []
+    for x, y, height in world:
+        i, j = cell(mapping, x, y)
+        assert float(mapping.elevation_map[2, i, j]) == 1.
+        observed = float(mapping.elevation_map[0, i, j])
+        assert observed == pytest.approx(height, abs=.002)
+        assert float(mapping.observation_stamps[0, i, j]) == 102.125
+        measured.append(observed)
+    measured = np.asarray(measured)
+    assert np.max(np.abs(measured[world[:, 2] == 0.])) < .002
+    assert np.min(measured[world[:, 2] == .3]) > .298
+    assert np.min(measured[world[:, 2] == .7]) > .698
+    assert np.ptp(measured) > .698
+
+
+def test_drift_uses_reproducible_mean_before_gaussian_conditioning(make_map):
+    mapping = make_map(enable_drift_compensation=True,
+                       min_height_drift_cnt=2,
+                       position_noise_thresh=.01,
+                       orientation_noise_thresh=.01,
+                       drift_compensation_alpha=.5)
+    samples = []
+    cells = []
+    for x in [.437, .637, .837]:
+        for y in [-.163, .037, .237]:
+            cells.append(seed(mapping, (x, y), -.62, .02))
+            samples.append([x, y, -.6])
+    integrate(mapping, samples, stamp=100.125, position_noise=.05)
+    # All nine independent cells see the same +2cm measurement residual.
+    # The documented 0.5 correction shifts each prior by +1cm before the
+    # independent Gaussian measurement update. This is an analytic fixture,
+    # not a comparison against another invocation of the implementation.
+    expected_h, expected_v = reference_batch(-.61, .02, [-.6], [-.6],
+                                             mapping.param.sensor_noise_factor)
+    assert float(mapping.mean_error) == pytest.approx(.02, abs=5e-7)
+    for i, j in cells:
+        assert float(mapping.new_map[2, i, j]) == 1.
+        assert float(mapping.elevation_map[0, i, j]) == pytest.approx(expected_h, abs=3e-7)
+        assert float(mapping.elevation_map[1, i, j]) == pytest.approx(expected_v, abs=3e-8)
+        assert float(mapping.observation_stamps[0, i, j]) == 100.125
+
