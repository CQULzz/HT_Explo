 import cupy as cp
 
 
+def get_filter_cupy(w1, w2, w3, w_out):
+    """Run the saved traversability CNN with CuPy when CUDA PyTorch is absent."""
+    from cupyx.scipy.ndimage import correlate
+
+    weights = [cp.asarray(w, dtype=cp.float32) for w in (w1, w2, w3)]
+    output_weights = cp.asarray(w_out, dtype=cp.float32).reshape(-1)
+
+    def filter_map(elevation):
+        image = cp.asarray(elevation, dtype=cp.float32)
+        responses = []
+        for dilation, branch in enumerate(weights, start=1):
+            for kernel in branch[:, 0]:
+                expanded = cp.zeros((2 * dilation + 1, 2 * dilation + 1), dtype=cp.float32)
+                expanded[::dilation, ::dilation] = kernel
+                response = correlate(image, expanded, mode="constant")
+                responses.append(response[3:-3, 3:-3])
+        score = sum(cp.abs(response) * weight for response, weight in zip(responses, output_weights))
+        return cp.exp(-score)[None, None, :, :]
+
+    return filter_map
+
+
