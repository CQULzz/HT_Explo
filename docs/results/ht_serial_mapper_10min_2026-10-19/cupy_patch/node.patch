+class TfListenerWorker:
+    """Receive TF independently while serialized map callbacks perform lookups."""
+
+    def __init__(self, buffer, owner):
+        from rclpy.executors import SingleThreadedExecutor
+        from rclpy.parameter import Parameter as RosParameter
+        self.node = Node(
+            "elevation_mapping_tf_listener", context=owner.context,
+            namespace=owner.get_namespace(), use_global_arguments=False,
+            parameter_overrides=[RosParameter(
+                "use_sim_time", value=owner.get_parameter("use_sim_time").value)],
+        )
+        self.listener = TransformListener(buffer, self.node)
+        self.executor = SingleThreadedExecutor(context=owner.context)
+        self.executor.add_node(self.node)
+        self.closed = False
+        self.thread = threading.Thread(
+            target=self.executor.spin, name="elevation-tf-listener")
+        self.thread.start()
+
+    def close(self):
+        if self.closed:
+            return
+        self.closed = True
+        self.executor.shutdown()
+        self.thread.join()
+        self.executor.remove_node(self.node)
+        self.listener.unregister()
+        self.node.destroy_node()
+
