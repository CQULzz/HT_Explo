+    for(int i=0;i<235;++i)manager->AddUncoveredPoint(0,i);
+    for(int i=0;i<63;++i)manager->AddUncoveredFrontierPoint(0,i);
+    ASSERT_EQ(manager->HT()->enabled(),htMode());
