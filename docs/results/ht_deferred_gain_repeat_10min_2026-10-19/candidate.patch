+
+  nh->get_parameter("scanVoxelSize", scanVoxelSize);
+  nh->get_parameter("decayTime", decayTime);
+  nh->get_parameter("noDecayDis", noDecayDis);
+  nh->get_parameter("clearingDis", clearingDis);
