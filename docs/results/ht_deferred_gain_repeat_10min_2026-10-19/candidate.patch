+int terrainVoxelUpdateNum[terrainVoxelNum] = { 0 };
+float terrainVoxelUpdateTime[terrainVoxelNum] = { 0 };
+float planarVoxelElev[planarVoxelNum] = { 0 };
+int planarVoxelConn[planarVoxelNum] = { 0 };
