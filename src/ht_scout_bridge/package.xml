<?xml version="1.0"?>
<package format="3">
  <name>ht_scout_bridge</name><version>0.1.0</version>
  <description>Calibrated Scout real-vehicle inputs for HT exploration.</description>
  <maintainer email="noreply@example.com">HT maintainers</maintainer><license>BSD-3-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>grid_map_msgs</exec_depend><exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend><exec_depend>rviz2</exec_depend>
  <exec_depend>tare_planner</exec_depend><test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
