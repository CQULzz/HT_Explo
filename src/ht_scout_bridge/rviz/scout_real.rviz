Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Body support diagnosis - R0.6m1
    Splitter Ratio: 0.5
  Tree Height: 560
- Class: rviz_common/Views
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 100; 100; 100
    Enabled: true
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: Ground Grid
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 20
    Reference Frame: map
    Value: true
  - Alpha: 0.5
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Min Color: 0; 0; 0
    Name: Measured height - GRAY is not traversability
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.04
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /ht_real/visualization/measured_height
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 1.0
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Min Color: 0; 0; 0
    Name: HT best probability - green high red low
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 4
    Size (m): 0.04
    Style: Flat Squares
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /ht_real/visualization/best_probability
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Runtime reason and startup prior
    Enabled: true
    Value: true
    Topic:
      Value: /ht_real/runtime_markers
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
    Namespaces: {}
    Queue Size: 5
  - Alpha: 1
    Autocompute Intensity Bounds: false
    Class: grid_map_rviz_plugin/GridMap
    Color: 200; 200; 200
    Color Layer: ht_interpolated
    Color Transformer: IntensityLayer
    Enabled: false
    Height Layer: ht_elevation
    Height Transformer: GridMapLayer
    History Length: 1
    Invert Rainbow: false
    Max Color: 255; 0; 255
    Max Intensity: 1
    Min Color: 255; 20; 20
    Min Intensity: 0
    Name: Small-hole interpolation provenance
    Show Grid Lines: false
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /ht_real/traversability
    Use Rainbow: false
    Value: false
  Enabled: true
  Global Options:
    Background Color: 20; 20; 20
    Fixed Frame: map
    Frame Rate: 10
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.0
      Target Frame: base_link
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.8
    Saved: null
Window Geometry:
  Height: 900
  Width: 1500
  X: 100
  Y: 50
